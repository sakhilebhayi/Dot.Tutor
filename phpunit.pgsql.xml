<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The whole suite (666+ tests in one process) outgrows 128 MB after the design-system merge; R-47 D-1405. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <!-- DB_DATABASE, DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD come from the environment: bin/test-pgsql.sh creates a throwaway database and passes them (R-47 D-1407). -->
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="ANTHROPIC_API_KEY" value=""/>
        <!-- Same as phpunit.xml: fixtures are adults who never declared an age; the production default 'ask' is pinned in tests/Feature/Security (D-1502). -->
        <env name="SAFETY_UNKNOWN_AGE_POLICY" value="adult"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
            <env name="ALLOW_REGISTRATION" value="true"/>
    </php>
</phpunit>
