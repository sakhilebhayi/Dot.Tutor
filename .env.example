# Dot.Tutor environment. This file is copied to .env by CI and by `composer setup`, so every value here is SAFE: a local
# address, no real provider switched on, no secret. The live host's .env is made from it and then filled in by the owner
# (docs/deployment.md lists the host values; docs/R47_OPERATIONS.md the order to switch providers on). After editing a
# host .env run `php artisan config:cache` and `php artisan tutor:preflight`.
# Lines starting "# NAME=value" show a setting at its built-in default: uncomment only to change it.

APP_NAME="Dot.Tutor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Live host: https://tutor.infodot.co.za (payment returns, emails, push and calendar links are built from it).
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Live host: warning (debug floods the log on a platform that polls).
LOG_LEVEL=debug

# Local development uses a SQLite file (database/database.sqlite). The live host uses the cPanel database it was given:
# DB_CONNECTION=pgsql with DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD (or sqlite with an absolute path).
# The deploy copies whichever it is before every migration.
DB_CONNECTION=sqlite
# SQLite under concurrent requests only (docs/R47_PERF.md section 3): DB_JOURNAL_MODE=wal, DB_TRANSACTION_MODE=IMMEDIATE.
# DB_BUSY_TIMEOUT defaults to 5000 ms.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Live host (https): true, so the session cookie is never sent over http.
# SESSION_SECURE_COOKIE=true

# Nothing in Dot.Tutor broadcasts (screens poll short feeds); Reverb cannot run on shared hosting. Keep log.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database: the cron-driven worker (deploy.yml) runs Paystack webhooks, notification delivery and the Analytics snapshot.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log writes every email to the log file and nobody receives it. Live host: MAIL_MAILER=smtp with MAIL_SCHEME, MAIL_HOST,
# MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD of the no-reply@infodot.co.za account the other Dot apps use.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"

# ---- Payments (docs/R47_MONEY.md). Paystack is OFF while the key is blank: paid items say online payment is not
# enabled. A sk_test_ key is test mode (no real money). A sk_live_ key is REFUSED unless PAYSTACK_ALLOW_LIVE=true is
# also set: the second switch. Webhook URL in the Paystack dashboard: <APP_URL>/api/tutor/money/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_ALLOW_LIVE=false
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_ATTEMPT_TTL_MINUTES=30
# Comma list to limit the checkout methods, e.g. card,eft (blank = Paystack's defaults).
# PAYSTACK_CHANNELS=
# MONEY_CURRENCY=ZAR
# MONEY_ORDER_TTL_MINUTES=60
# Owner settings, not market facts (docs/R47_RESEARCH.md "Tutor economics"):
# MONEY_COMMISSION_PERCENT=15
# MONEY_PASS_GATEWAY_FEE_PERCENT=0
# MONEY_TUTOR_FIXED_FEE_MINOR=0
# MONEY_LESSON_HOLD_HOURS=24
# MONEY_REFUND_WINDOW_DAYS=7
# MONEY_COURSE_REFUND_WINDOW_DAYS=7
# MONEY_RESOURCE_REFUND_WINDOW_DAYS=7
# Payouts: a CSV batch is drafted on MONEY_PAYOUT_DAY (ISO weekday, 1 = Monday) at 06:00; minimum in cents.
# MONEY_PAYOUT_MINIMUM_MINOR=10000
# MONEY_PAYOUT_DAY=1
# true only with a Registered Business on Paystack with transfers enabled.
MONEY_PAYSTACK_TRANSFERS=false
# true holds a buyer of unknown age for a guardian, as if a minor.
# MONEY_HOLD_UNKNOWN_AGE=false
# Comma list of operator emails allowed to refund, credit and pay out (blank = every platform operator).
# MONEY_FINANCE_OPERATOR_EMAILS=
# Receipts: VAT lines only when registered AND a number is set. Missing operator details are left off, never invented.
# MONEY_VAT_REGISTERED=false
# MONEY_VAT_NUMBER=
# MONEY_VAT_RATE=15
# MONEY_OPERATOR_LEGAL_NAME=
# MONEY_OPERATOR_TRADING_NAME="${APP_NAME}"
# MONEY_OPERATOR_REGISTRATION=
# MONEY_OPERATOR_ADDRESS=
# MONEY_SUPPORT_EMAIL=
# MONEY_RECEIPT_PREFIX=TUT
# Legacy names, still read as fallbacks:
# TUTOR_CURRENCY=ZAR
# TUTOR_TIMEZONE=Africa/Johannesburg

# ---- AI assistant (docs/R47_AI.md). Off unless AI_ENABLED=true and a key is set; nothing is sent otherwise.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MODEL_LIGHT=claude-opus-5-5
AI_MONTHLY_BUDGET_USD=100
AI_LOG_RETENTION_DAYS=180
# AI_EFFORT=medium
# AI_EFFORT_LIGHT=low
# AI_REFUSAL_FALLBACK=true
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=1
# AI_PER_MINUTE=6
# child | teen | adult: the guardrails used when a learner's age is not known.
# AI_UNKNOWN_AGE_BAND=child
# AI_EVIDENCE_RETENTION_DAYS=730

# ---- Notifications (docs/R47_COMMS.md). Web Push is off without VAPID keys: `php artisan comms:vapid-keys` prints a
# pair; set them once and never change them (every device would have to switch push on again).
COMMS_VAPID_PUBLIC_KEY=
COMMS_VAPID_PRIVATE_KEY=
# COMMS_VAPID_SUBJECT=mailto:no-reply@infodot.co.za
# COMMS_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com,notify.windows.com,push.apple.com
# No SMS adapter is installed: leave blank.
COMMS_SMS_DRIVER=
# COMMS_RETENTION_DAYS=120
# Dot.Notify events (blank = none are sent; Dot.Tutor sends its own email).
NOTIFY_INGEST_URL=
NOTIFY_INGEST_SECRET=
# NOTIFY_PLATFORM_KEY=tutor

# ---- Live classroom (docs/R47_CLASSROOM.md). STUN defaults to Google's public server ("none" turns it off). Without a
# TURN relay some learners on mobile data or school networks cannot connect; the classroom says so.
# CLASSROOM_STUN_URLS=stun:stun.l.google.com:19302
CLASSROOM_TURN_URLS=
# Either a shared secret (coturn use-auth-secret; time-limited credentials per person) ...
CLASSROOM_TURN_SECRET=
# CLASSROOM_TURN_TTL=3600
# ... or a fixed username and credential.
CLASSROOM_TURN_USERNAME=
CLASSROOM_TURN_CREDENTIAL=
# CLASSROOM_OPEN_MINUTES_BEFORE=10
# CLASSROOM_GRACE_MINUTES_AFTER=30
# CLASSROOM_MAX_IN_ROOM=6
# CLASSROOM_PRESENCE_SECONDS=30
# CLASSROOM_SIGNAL_TTL_SECONDS=120

# ---- Safeguarding (docs/R47_SAFETY.md)
# adult | teen | child: how a person with no recorded birth date is treated.
# SAFETY_UNKNOWN_AGE_POLICY=adult
# SAFETY_MESSAGES_PER_MINUTE=20
# SAFETY_CONVERSATIONS_PER_HOUR=10
# A second operator must confirm every screening record.
# SAFETY_SCREENING_FOUR_EYES=true

# ---- Learning (docs/R47_LEARNING.md). Files stay on the private disk under storage/app/private/learning; a root
# elsewhere is NOT covered by scripts/ops/backup.sh. Upload limits must fit the host PHP's upload_max_filesize.
# LEARNING_DISK_ROOT=
# LEARNING_MAX_UPLOAD_KB=20480
# LEARNING_MAX_VIDEO_KB=204800
# LEARNING_SIGNED_URL_MINUTES=10
# LEARNING_THROTTLE_UPLOADS=20
# LEARNING_THROTTLE_ATTEMPTS=30
# LEARNING_THROTTLE_REPORTS=10

# ---- Community rooms (docs/R47_COMMUNITY.md)
# COMMUNITY_POSTS_PER_MINUTE=5
# COMMUNITY_POSTS_PER_DAY=60
# COMMUNITY_EDITS_PER_MINUTE=10
# COMMUNITY_HOLD_AFTER_REPORTS=3
# COMMUNITY_TIMEZONE=Africa/Johannesburg

# ---- Marketplace rate limits (per person per minute)
# TUTOR_THROTTLE_BOOKINGS=10
# TUTOR_THROTTLE_UPLOADS=10
# TUTOR_THROTTLE_MATCHING=30
# TUTOR_THROTTLE_REVIEWS=10

# InfoDot sign-in (signed redeem). This app has its own database, so InfoDot's
# one-time handoff token is proved by calling InfoDot rather than looked up here.
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_TUTOR in InfoDot's .env, and
# InfoDot must have this platform marked live. Blank = old local-token behaviour only.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=tutor
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true
# ECOSYSTEM_HANDOFF_TTL=5
# Platform-switcher links; live host: DOT_INFODOT_URL=https://infodot.co.za (and the other DOT_*_URL as they go live).
# DOT_INFODOT_URL=

# Daily aggregate metrics snapshot to Dot.Analytics (blank = nothing is sent). URL is the full ingest URL, e.g.
# https://analytics.infodot.co.za/api/ingest/snapshots. The secret must equal ANALYTICS_INGEST_SECRET_TUTOR in Analytics' .env.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=tutor

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false

# Browser security headers (config/security.php). HSTS is sent on HTTPS responses only, in seconds (0 turns it off); no
# includeSubDomains. The Content-Security-Policy is report-only: violations are logged through /csp-report. Setting
# SECURITY_CSP_REPORT_ONLY=false would enforce it; leave that until the reports have been reviewed.
SECURITY_HSTS_SECONDS=15552000
SECURITY_CSP_REPORT_ONLY=true
